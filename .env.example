# App
# Point at your deployed PartyKit host (e.g. collaborative-canvas.your-account.partykit.dev).
# Leave unset in local dev: `npx partykit dev` serves on the same origin as the app.
NEXT_PUBLIC_PARTYKIT_HOST=
PARTYKIT_TOKEN=
PARTYKIT_SECRET=your-partykit-secret

# Database (optional but recommended)
# Without it the app runs in memory-only mode: real-time sync works, boards are not saved.
DATABASE_URL=postgresql://user:password@localhost:5432/collaborative_canvas
